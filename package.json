{
  "name": "newtours-playwright-ts",
  "version": "1.0.0",
  "description": "Automatización web Playwright + TypeScript + Cucumber (Gherkin) con el runner nativo de Playwright",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "test:ui": "bddgen && playwright test --ui",
    "test:debug": "bddgen && playwright test --debug",
    "test:smoke": "bddgen && playwright test --grep \"@smoke\"",
    "test:regresion": "bddgen && playwright test --grep \"@regresion\"",
    "report": "playwright show-report",
    "allure:serve": "allure serve allure-results",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.13.10",
    "allure-commandline": "^2.32.2",
    "allure-playwright": "^3.2.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.35.0",
    "eslint-plugin-playwright": "^2.2.2",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.42.0"
  }
}
